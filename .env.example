# ==============================================================================
# AI Question Paper Generator - Environment Configuration
# ==============================================================================

# Active LLM Provider: 'groq' | 'openai' | 'gemini' | 'nim'
LLM_PROVIDER=groq

# 1. Groq Cloud (Default)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 2. OpenAI API
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Google Gemini API
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 4. NVIDIA NIM (OpenAI-compatible Cloud or Local Microservice)
NIM_API_KEY=nvapi-your_nvidia_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# ==============================================================================
# Server & Reverse-Proxy Deployment Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=8050
DEBUG=False

# Subpath / URL Prefix for Reverse-Proxy deployment (e.g. '/question-paper' or 'https://domain.com:8054/question-paper/')
# Automatically sanitizes full URLs to path component only (e.g. '/question-paper')
APPLICATION_ROOT=
URL_PREFIX=

# Public Canonical Origin (e.g. 'https://exam.school.edu:8443')
PUBLIC_ORIGIN=

# Trusted Proxies (Comma-separated IPs or CIDR, or '*' for container reverse proxies)
TRUSTED_PROXIES=*

# Document Upload & Payload Limit in Megabytes (DOCX & PDF textbooks)
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (Comma-separated list or '*' for all)
CORS_ORIGINS=*
