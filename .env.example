# ==============================================================================
# AI Question Paper Generator - Environment Configuration
# ==============================================================================

# Active LLM Provider: 'groq' | 'openai' | 'gemini' | 'nim'
LLM_PROVIDER=groq

# 1. Groq Cloud (Default)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 2. OpenAI API
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Google Gemini API
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 4. NVIDIA NIM (OpenAI-compatible Cloud or Local Microservice)
NIM_API_KEY=nvapi-your_nvidia_api_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct

# Server Configuration
HOST=0.0.0.0
PORT=8050
DEBUG=True
